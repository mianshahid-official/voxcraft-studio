# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDEs, OS, and Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Large Offline Neural Model Weights (>50MB)
# Automatically downloaded via Setup Wizard or In-App Model Hub
*.onnx
*.safetensors
*.bin
*.pt
*.pth
*.npz
*.npy

# Generated Audio Exports, Cache, and Runtime Logs
exports/*
!exports/.gitkeep
cache/*
!cache/.gitkeep
logs/*
!logs/.gitkeep
projects/*.sqlite
*.zip
*.tar.gz
tts/
tts.zip

# Preserve required directory structures & reference assets
!.gitkeep
!exports/.gitkeep
!cache/.gitkeep
!logs/.gitkeep
!projects/.gitkeep
!models/.gitkeep
!models/kokoro/.gitkeep
!models/piper/.gitkeep
!models/f5tts/.gitkeep
!models/f5tts/vocab.txt
!data/reference_voices/*
!app/resources/icons/*
